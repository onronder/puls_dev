        {
          "caniasField": "DEPT_CODE",
          "pulsColumn": "code",
          "required": true,
          "transform": "trim_string",
          "conflictRule": "external_id_match_updates_imported_row_only",
          "errorClass": "missing_required_field"
        },
        {
          "caniasField": "DEPT_NAME",
          "pulsColumn": "name",
          "required": true,
          "transform": "trim_string",
          "conflictRule": "external_id_match_updates_imported_row_only",

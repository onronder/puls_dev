{
  "version": "pr13.7-canias-discovery-v1",
  "provider": "canias",
  "posture": "discovery_only_no_runtime",
  "sourceNamespace": "canias_erp",
  "sourceNamespaceSeedCrosswalk": {
    "discoveryLabel": "canias_erp",
    "seedNamespaceCode": "CANIAS",
    "seedExternalSourceValue": "canias"
  },
  "seedSampleReference": "puls_integration.erp_field_mappings and entity_identity_map rows in PR13.4 seed are demo samples only — not customer truth",
  "transportModes": [
    "manual_csv",
    "scheduled_file_exchange",
    "excel_xml",
    "staging_table",
    "api_future",
    "controlled_export_future"
  ],
  "guardrails": [
    "no_automatic_destructive_erp_writes",
    "human_confirmation_required",
    "no_credentials_in_repo",
    "source_disclosure_required"

# Supabase (Frankfurt) — get from Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only (Railway / CI — NEVER commit real values)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Railway services
RAILWAY_LLM_GATEWAY_URL=https://llm-gateway-production.up.railway.app
RAILWAY_ERP_CONNECTOR_URL=https://erp-connector-production.up.railway.app

# LLM (Railway llm-gateway only — not frontend)
ANTHROPIC_API_KEY=

# App
VITE_APP_URL=http://localhost:3000
VITE_PULS_DEMO_MODE=false
# Production override — demo fallback blocked when PROD === true unless explicitly enabled
# VITE_PULS_ALLOW_DEMO_FALLBACK_IN_PROD=false

# Observability (optional — no real DSN values in repo)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_RELEASE=
